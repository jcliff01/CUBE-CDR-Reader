<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CUBE-CDR-Reader</AssemblyName>
    <RootNamespace>CubeCdrReader</RootNamespace>
    <!-- Lets the app compile on Linux and macOS build machines; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CubeCdrReader.Core\CubeCdrReader.Core.csproj" />
  </ItemGroup>
</Project>
